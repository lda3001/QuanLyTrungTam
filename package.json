{
  "name": "quanly-trungtam",
  "version": "1.0.0",
  "description": "Ứng dụng Desktop quản lý trung tâm dạy học",
  "author": "Center Manager",
  "main": "./out/main/index.js",
  "build": {
    "appId": "com.qltt.app",
    "productName": "QuanLyTrungTam",
    "mac": {
      "icon": "build/icon.icns"
    },
    "win": {
      "icon": "build/iconreal.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icons"
    }
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run build:server && node dist-server/index.mjs",
    "dev:client": "vite",
    "start": "npm run build:server && node dist-server/index.mjs",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --alias:@shared=./src/shared --alias:@main=./src/main --outfile=dist-server/index.mjs",
    "build:client": "vite build",
    "package:portable": "npm run build && node scripts/package-portable.mjs",
    "build:github-update": "node scripts/build-github-update.mjs",
    "release:github": "node scripts/build-github-update.mjs --publish",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-builder install-app-deps",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --ext .ts,.tsx --cache",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "db:generate": "drizzle-kit generate",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "build:unpack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.2.0",
    "@mui/x-date-pickers": "^9.10.1",
    "better-sqlite3": "^12.11.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-session": "^1.18.1"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.66.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^5.24.0",
    "axios": "^1.7.9",
    "dayjs": "^1.11.21",
    "drizzle-kit": "^0.31.10",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.5",
    "recharts": "^2.15.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  }
}
